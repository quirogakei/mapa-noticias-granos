name: Actualizar mapa
on:
  schedule:
       - cron: "*/5 * * * *"   # todos los días a las 9:00 UTC (6:00 en Argentina)
  workflow_dispatch:       # permite ejecutarlo a mano
permissions:
  contents: write
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install feedparser plotly pandas
      - run: python mapa_noticias_granos.py
      - run: |
          git config user.name "bot"
          git config user.email "bot@users.noreply.github.com"
          git add index.html
          git commit -m "Actualización automática" || exit 0
          git push
